type SourceLink = { label: string; url: string } | null;
type PublicationLinkType = {
  type: 'doi' | 'arxiv' | 'external';
  href: string;
  identifier?: string;
  label?: string;
};

function normaliseLink(link: SourceLink): PublicationLinkType | null {
  if (!link) return null;

  const arxivId = `${link.label} ${link.url}`.match(/arxiv(?:\.org\/abs\/|\.)(\d{4}\.\d{4,5})/i)?.[1];
  if (arxivId) return { type: 'arxiv', href: link.url, identifier: arxivId };

  const doi = link.label.match(/^10\.\S+$/)?.[0]
    ?? link.url.match(/doi\.org\/(10\.[^?#]+)/i)?.[1];
  if (doi) return { type: 'doi', href: link.url, identifier: doi };

  return { type: 'external', href: link.url, label: link.label };
}

function publicationLinks(publication: (typeof publications)[number]): PublicationLinkType[] {
  const order = { doi: 0, arxiv: 1, external: 2 };
  const links = [publication.doi, publication.repository]
    .map(normaliseLink)
    .filter((link): link is PublicationLinkType => Boolean(link));

  return links
    .filter((link, index) => {
      const key = `${link.type}:${link.identifier?.toLowerCase() ?? link.href.toLowerCase()}`;
      return links.findIndex((candidate) =>
        `${candidate.type}:${candidate.identifier?.toLowerCase() ?? candidate.href.toLowerCase()}` === key
      ) === index;
    })
    .sort((a, b) => order[a.type] - order[b.type]);
}
