      <p class="page-intro">
        The HALT project is composed mostly of academic research institutions and universities.
        Its primary research outputs are peer-reviewed publications, listed below.
      </p>
    </div>
  </section>

  <section class="halt-content">
    <div class="container">
      <ul class="list">
        {publications.map((publication) => (
          <li>
            {publication.authors}. <strong>{publication.title}</strong>.
            {' '}<em>{publication.journal}</em>, <strong>{publication.details.volume}</strong>, {publication.details.locator}, ({publication.details.year}).
            {publicationLinks(publication).map((link) => (
              <>&emsp;<PublicationLink {...link} /></>
            ))}
          </li>
        ))}
      </ul>
    </div>
  </section>
</HaltLayout>
