---
import HaltLayout from '../../layouts/HaltLayout.astro';
---

<HaltLayout title="HALT Activities" description="Research and training activities from the HALT project">
<section class="halt-title">
    <div class="container">
        <h1>Research and Training Activities</h1>
        <p class="page-intro">
            As part of HALT we fund and organize a variety of research conferences and workshops, summer schools, and early career training events.
        </p>
    </div>
</section>

<section class="halt-content">

    <div class="container">
        <div class="grid">
            <div class="span-full">
                <h2>
                    <strong>Research Activities</strong></h2>
            </div>
        </div>
    </div>
</section>

<section class="halt-media">

    <div class="container">
        <div class="grid">
            <div class="span-4">
                <div class="image-wrapper">
                    <img src="/haltproject/assets/images/screenshot-2022-09-25-at-15.35.54-576x460.png" alt="Waves, coherent structures, and turbulence workshop" width="576" height="460" decoding="async">

                </div>
            </div>
            <div class="span-fill">

                    <h3>
                        <strong>Waves, coherent structures, and turbulence</strong><br><strong>30th Oct - 1st Nov 2019, UK</strong></h3>
                    <p class="prose">
                        The workshop will bring together physicists and applied mathematicians researching in the area of waves, coherent structures and turbulence.</p>

            </div>
        </div>
    </div>
</section>

<section class="halt-media">

    <div class="container">
        <div class="grid">
            <div class="span-4">
                <div class="image-wrapper">
                    <img src="/haltproject/assets/images/parc-de-valrose-816x612.jpg" alt="Parc de Valrose in Nice, France" width="816" height="612" loading="lazy" decoding="async">

                </div>
            </div>
            <div class="span-fill">

                    <h3>
                        <strong>Universal features of hydrodynamics, optical, and wave turbulence</strong><br><strong>9th Sept - 12th Sept 2019, France</strong></h3>
                    <p class="prose">
                         The purpose of the conference is to bring together researchers working in the broad areas of nonlinear physics (fluid dynamics, turbulence, nonlinear optics), condensed-matter physics and non-equilibrium statistical mechanics to review the recent advancements in the fields of hydrodynamic, wave, superfluid and optical turbulence and to identify future challenges.</p>

            </div>
        </div>
    </div>
</section>

<section class="halt-media">

    <div class="container">
        <div class="grid">
            <div class="span-4">
                <div class="image-wrapper">
                    <img src="/haltproject/assets/images/picture-1-816x546.jpeg" alt="Vortex dynamics summer school in Brazil" width="721" height="503" loading="lazy" decoding="async">

                </div>
            </div>
            <div class="span-fill">

                    <h3>
                        <strong>Vortex dynamics, turbulence, and related phenomena in quantum fluids</strong><br><strong>24th June - 5th July 2019, Brazil</strong></h3>
                    <p class="prose">
                        This summer school and conference concerns all issues related to the dynamics of vortices in superfluid and quantum turbulence.</p>

            </div>
        </div>
    </div>
</section>

<section class="halt-content">

    <div class="container">
        <div class="grid">
            <div class="span-full">
                    <h2>
                        <strong>Training Activities</strong></h2>
            </div>
        </div>
    </div>
</section>

<section class="halt-media">

    <div class="container">
        <div class="grid">
            <div class="span-4">
                <div class="image-wrapper">
                    <img src="/haltproject/assets/images/picture-2-816x398.png" alt="Career opportunities workshop for early-career researchers" width="816" height="398" loading="lazy" decoding="async">

                </div>
            </div>
            <div class="span-fill">

                    <h3>
                        <strong>Career opportunities for early-career researchers</strong><br><strong>21st Jan 2020, UK</strong></h3>
                    <p class="prose">
                        A full-day information workshop for early-career academics with topical talks on: grant applications, open science, how to write publications, and cloud computing.</p>

            </div>
        </div>
    </div>
</section>
</HaltLayout>
