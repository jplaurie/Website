---
import LineIcon from './LineIcon.astro';
import { normalizePath } from '../utils/paths';

const currentPath = normalizePath(Astro.url.pathname);
const isCurrent = (href: string) => normalizePath(href) === currentPath;
const activityLinks = [
  { href: '/haltproject.html', label: 'Horizon 2020 MSCA-RISE HALT' },
  { href: '/leverhulme.html', label: 'Leverhulme Trust Project' },
  { href: '/sigwt.html', label: 'UK Fluids Network SIG in Wave Turbulence' },
];
const activitiesAreCurrent = activityLinks.some(({ href }) => {
  const projectPath = normalizePath(href);
  return currentPath === projectPath || currentPath.startsWith(`${projectPath}/`);
});
---

<header class="site-header">
  <nav class="nav-wrap" aria-label="Main navigation">
    <a class="site-name" href="/index.html">Dr Jason Laurie</a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-navigation">
      <span></span><span></span><span></span>
      <span class="sr-only">Toggle navigation</span>
    </button>
    <div class="nav-links" id="site-navigation">
      <a href="/index.html" aria-current={isCurrent('/index.html') ? 'page' : undefined}><LineIcon name="home" />Home</a>
      <a href="/research.html" aria-current={isCurrent('/research.html') ? 'page' : undefined}><LineIcon name="research" />Research</a>
      <details class:list={{ 'is-current': activitiesAreCurrent }}>
        <summary><LineIcon name="calendar" />Activities</summary>
        <div class="nav-dropdown">
          {activityLinks.map(({ href, label }) => (
            <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>{label}</a>
          ))}
        </div>
      </details>
      <a href="/publications.html" aria-current={isCurrent('/publications.html') ? 'page' : undefined}><LineIcon name="document" />Publications</a>
      <a href="/teaching.html" aria-current={isCurrent('/teaching.html') ? 'page' : undefined}><LineIcon name="edit" />Teaching</a>
    </div>
  </nav>
</header>
